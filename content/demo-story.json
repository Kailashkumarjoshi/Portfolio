    {
      "id": "demo-4",
      "slug": "the-coast-road",
      "title": "The Coast Road",
      "subtitle": "No plan, half a tank, one playlist",
      "event_date": "2020-08-21",
      "date_label": null,
      "chapter": "Learning Each Other",
      "description": "We drove until the road ran out. You navigated badly on purpose so we'd take longer. The light went gold, then pink, then that deep blue where you can't tell the sea from the sky, and we pulled over and didn't say anything for a long time.",
