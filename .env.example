# ---------------------------------------------------------------------------
# Connect this site to your own Supabase project.
# Both values come from Supabase → Project Settings → API.
# Until they are filled in, the site runs on the bundled sample story.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional. Only needed if you want the one-time "create the first keeper"
# button in the admin panel to work. Keep it secret — never share it, and never
# put it anywhere with NEXT_PUBLIC_ in the name.
SUPABASE_SERVICE_ROLE_KEY=
